{
  "name": "digitalspot-cms",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "PAYLOAD_CONFIG_PATH=payload.config.ts payload build && tsc --project tsconfig.json",
    "start": "node dist/src/server.js",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/lib-storage": "^3.940.0",
    "@payloadcms/bundler-webpack": "^1.0.9",
    "@payloadcms/db-mongodb": "^1.7.5",
    "@payloadcms/plugin-cloud-storage": "^1.2.2",
    "@payloadcms/richtext-lexical": "^0.11.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "payload": "^2.32.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "graphql": "16.12.0"
  }
}
